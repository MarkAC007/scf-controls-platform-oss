# Node modules - always use container's own install
**/node_modules
webclient/node_modules

# Build outputs
webclient/dist
**/dist

# Git
.git
.gitignore
.gitmodules

# IDE
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Local environment files (handled separately)
.env.local
.env.*.local

# Test files
**/*.test.ts
**/*.spec.ts
**/__tests__

# Documentation
docs/
*.md
!README.md

# Archives
_archive/

# Release record. The release workflow writes it into the release commit after
# the images are built; it names their digests. It must never be an input to a
# build, or building from a release tag would use a context the published
# images did not have.
release-images.json
release-evidence
