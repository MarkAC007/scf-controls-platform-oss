# =============================================================================
# SCF Controls Platform — environment template
#
# Quick start:
#   cp .env.example .env
#   # edit the REQUIRED values below, then:
#   docker compose --profile init run --rm catalog-importer   # one-time catalogue import
#   docker compose up -d
#
# The defaults below are enough to boot the stack locally for evaluation.
# CHANGE every value marked REQUIRED before exposing this to a network.
# Never commit your filled-in .env — only this .env.example is tracked.
# =============================================================================

# ---- REQUIRED -------------------------------------------------------------
# Postgres password. Compose builds DATABASE_URL from this:
#   postgresql+asyncpg://cg:${DB_PASSWORD}@postgres:5432/cg_scf
# Use a strong value in any shared/production environment.
DB_PASSWORD=changeme-postgres

# Backend API key (master key for programmatic access). Generate a real random
# value for anything beyond local eval, e.g.:  openssl rand -hex 32
API_KEY=changeme-generate-a-real-api-key

# Signing secret for evidence download links and upload tickets (#57). Falls
# back to API_KEY when blank, which is fine for most deployments; set it
# separately if you want to rotate evidence link signing without rotating the
# master API key. With neither set, the backend refuses to mint or accept
# either — browser download links disappear and upload confirmation is rejected,
# rather than the platform honouring signatures anyone could forge.
DOWNLOAD_TOKEN_SECRET=

# ---- EVIDENCE INTEGRITY ---------------------------------------------------
# Every stored evidence object is fetched once, hashed (SHA-256) and scanned for
# malware by a background task; the result is recorded against the file.
#
# Malware scanning talks to a ClamAV daemon. The bundled stack does NOT ship one,
# so point CLAMD_HOST at your own, or set MALWARE_SCAN_ENABLED=false to say so
# explicitly. Leaving scanning enabled with no reachable daemon records a scan
# error against each file — the platform will not report a file as clean because
# it failed to look at it.
MALWARE_SCAN_ENABLED=true
CLAMD_HOST=localhost
CLAMD_PORT=3310

# Files that predate this feature start unverified and are drained by an hourly
# background sweep, oldest first. Unverified files stay downloadable and keep
# counting toward posture in the meantime — the backlog is the platform's, not
# yours, and nobody's score moves when this ships. Set the flag false to stop the
# sweep; raise the batch (default 50, max 500) to drain a large backlog faster.
EVIDENCE_INTEGRITY_SWEEP_ENABLED=true
EVIDENCE_INTEGRITY_SWEEP_BATCH=50

# ---- CORE -----------------------------------------------------------------
# Logging verbosity: debug | info | warning | error
LOG_LEVEL=info

# Deployment environment: development | staging | production
# Ships as 'production' so a default deploy is safe. Only set 'development' on a
# trusted local machine — it enables debug error detail and uvicorn auto-reload.
ENVIRONMENT=production

# Self-hosted single-tenant mode (OSS). Set to 1 to let the master API_KEY act as
# admin on your single organisation — this is how the self-hosted UI authenticates.
# SAFE only for a genuine single-tenant deploy: the backend refuses it at startup if
# more than one organisation or human member exists. Leave UNSET / 0 for any
# multi-tenant or hosted deployment. (issue #662)
OSS_SINGLE_TENANT=1

# Version labels surfaced on the /version endpoint. CATALOG_VERSION is the
# fallback used when the catalogue git metadata is not mounted (the default for
# this Docker-only release) — set it to match the SCF workbook you imported.
CATALOG_VERSION=2025.4
# Fallback only — the real version is read from webclient/package.json (source of truth
# for the vX.Y.Z GitHub Release tags). Keep this aligned with it.
PLATFORM_VERSION=0.24.0

# ---- HOST PORTS (optional) ------------------------------------------------
# Host-side published ports, remappable when a default is already taken on your
# host (8000 and 9000 are popular defaults for other tools). Container-side
# ports never change. For deeper compose customisation, prefer a
# docker-compose.override.yml overlay (see UPGRADING.md) so `git pull` stays clean.
# BACKEND_PORT=8000        # FastAPI backend (http://localhost:8000)
# FRONTEND_PORT=5173       # Web UI (http://localhost:5173)
# MINIO_PORT=9000          # MinIO S3 API — presigned evidence up/downloads.
#                          # EVIDENCE_PUBLIC_ENDPOINT's default follows this
#                          # automatically for same-machine installs.
# MINIO_CONSOLE_PORT=9001  # MinIO web console
# POSTGRES_PORT=5432       # Postgres — published on 127.0.0.1 ONLY (local admin
#                          # tools). The app uses the internal docker network;
#                          # expose it wider only via a deliberate overlay.
# KEYCLOAK_PORT=8081       # Bundled Keycloak (--profile idp); keep KC_HOSTNAME in sync.

# ---- REVERSE PROXY / CUSTOM HOSTNAME (optional) ---------------------------
# Comma-separated hostnames the web UI will answer to, on top of localhost.
# ONLY applies to the Vite dev server (the docker-compose.dev.yml overlay), which
# rejects unknown Host headers with "Blocked request. This host is not allowed."
# The default production nginx frontend answers on any hostname, so you do not
# need this for a normal deployment. Ports and schemes are not part of the
# value; list the bare hostname.
# VITE_ALLOWED_HOSTS=scf.example.com,grc.internal

# ---- FRONTEND CONTENT SECURITY POLICY (optional) --------------------------
# The production frontend ships a CSP (see nginx.conf) that already allows
# Google auth, generic S3, eu-west-1 S3, Azure Blob, and — via the compose
# default below — the bundled MinIO on http://localhost:<MINIO_PORT>.
#
# Set EXTRA_CONNECT_SRC when the browser must reach an object-storage origin
# that is NOT in that list: an S3 region other than eu-west-1, a custom
# S3-compatible endpoint, or MinIO published under your own hostname. Symptom of
# a missing entry: evidence upload/download fails and the browser console shows
# "Refused to connect ... violates the following Content Security Policy".
# Space-separated list of origins. Set it EMPTY to allow nothing extra.
# EXTRA_CONNECT_SRC=https://*.s3.us-east-2.amazonaws.com https://files.example.com

# ---- FRONTEND -> BACKEND (optional) ---------------------------------------
# Where the frontend's nginx forwards /api/*. The default is the backend on the
# internal docker network and is correct for the bundled stack. Override only
# when the backend lives somewhere else (external host, managed service).
# BACKEND_URL=http://backend:8000

# ---- PLATFORM UPGRADES ----------------------------------------------------
# The backend polls the public GitHub Releases API once a day and surfaces an
# "update available" signal to platform admins on the Version Information panel.
# It is OUTBOUND-ONLY (no telemetry, no inbound access) and defaults to ON.
# Set to false / 0 to opt out entirely — recommended for air-gapped installs.
SCF_UPDATE_CHECK=true

# ---- SCHEDULED GRC AUTOMATION --------------------------------------------
# The backend runs daily Celery beat jobs to generate evidence collection tasks,
# send due/overdue task notifications, and refresh stale evidence windows.
# These jobs default to ON. Set either flag to false / 0 to opt out.
TASK_AUTOMATION_ENABLED=true
WINDOW_ASSESSMENT_NIGHTLY_ENABLED=true

# Backup acknowledgement for the backend migration guard. Normally you never set
# this: run ./scripts/upgrade.sh vX.Y.Z, which backs up BOTH data stores first
# and sets the ack for you. Set it manually (to the target version, e.g. 0.9.0,
# or "any") ONLY if you run a bare `docker compose up --build` and have your own
# verified backup — it lets the startup migration proceed without the script.
# SCF_MIGRATE_ACK=

# ---- AUTHENTICATION (Google OAuth — optional) -----------------------------
# Leave GOOGLE_AUTH_ENABLED=false to run with API-key auth only.
# If you enable it, set the client ID (backend + frontend must match).
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
# Frontend build-time copies of the above (baked into the bundle at build):
VITE_GOOGLE_AUTH_ENABLED=false
# Set true to use redirect-based OIDC sign-in (bundled Keycloak profile or BYO IdP).
# Takes precedence over Google sign-in in the web client. See the Bundled Identity
# Provider section below for the matching backend OIDC_* configuration.
VITE_OIDC_ENABLED=false
VITE_GOOGLE_CLIENT_ID=
# API key the frontend uses to call the backend (typically the same as API_KEY):
VITE_API_KEY=changeme-generate-a-real-api-key

# ---- Bundled Identity Provider (optional, compose profile "idp") -----------
# Two ways to get OIDC/SSO:
#
#   1. BUNDLED Keycloak — run the extra profile; it stores realm/users in the
#      existing postgres and auto-imports idp/scf-realm.json:
#          docker compose --profile idp up -d
#      The variables in THIS block are then required: the idp containers assert
#      them at startup and exit loudly if empty (KC_ADMIN_* have no static default).
#
#   2. BRING YOUR OWN external OIDC provider (Okta, Entra, Auth0, Google, …) —
#      do NOT start the "idp" profile; just set the OIDC_* values below to your
#      provider. The backend reads OIDC_* regardless of the profile.
#
# --- Keycloak admin (REQUIRED when using --profile idp; no defaults) --------
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=changeme-keycloak-admin
# Public base URL Keycloak advertises. Stays COMMENTED OUT for the default
# same-machine install: when unset, docker-compose.yml defaults it to
# http://localhost:<KEYCLOAK_PORT>, so it follows a remapped KEYCLOAK_PORT
# automatically. Uncomment and set it when the stack runs on a REMOTE host
# (use an address your browser can reach, e.g. http://my-docker-host:8081) or
# behind a reverse proxy (public https URL + KC_PROXY_HEADERS=xforwarded on the
# keycloak service).
# KC_HOSTNAME=http://localhost:8081
# If set, idp-init creates this Keycloak user on first boot with a RANDOM
# temporary password printed ONCE to the idp-init container logs. Leave blank to
# skip. (`docker compose --profile idp logs idp-init` to read it.)
BOOTSTRAP_ADMIN_EMAIL=
#
# --- OIDC wiring (backend). ISSUER vs DISCOVERY_URL is the classic footgun: ---
#   OIDC_ISSUER        = the PUBLIC issuer, byte-for-byte identical to the `iss`
#                        claim in tokens and to what the browser is redirected to.
#                        For the bundled Keycloak on the dev stack this is the
#                        host-visible URL below.
#   OIDC_DISCOVERY_URL = the INTERNAL realm base URL the BACKEND fetches
#                        server-side to load provider metadata/JWKS. Inside docker
#                        that is the internal service DNS name
#                        (http://keycloak:8080/realms/scf), which is NOT reachable
#                        from the browser. Set this to the BARE realm base only —
#                        the backend's get_discovery() appends
#                        `/.well-known/openid-configuration` itself, so DO NOT
#                        include that suffix here or you get a doubled path -> 404.
#                        If you set DISCOVERY_URL to the internal name but leave
#                        ISSUER as the internal name too, tokens minted with a
#                        public `iss` will fail validation behind a reverse proxy —
#                        keep ISSUER public, DISCOVERY internal.
#
# REMOTE-HOST DEPLOYS: the localhost values below only work when your browser
# runs on the Docker host itself. On a remote host, set OIDC_ISSUER and
# OIDC_REDIRECT_URI (and KC_HOSTNAME above) to an address YOUR BROWSER can
# reach (e.g. http://my-docker-host:8081/realms/scf) — and if you remapped
# KEYCLOAK_PORT or FRONTEND_PORT, use those ports here. OIDC_DISCOVERY_URL
# stays internal and never changes.
OIDC_ISSUER=http://localhost:8081/realms/scf
OIDC_DISCOVERY_URL=http://keycloak:8080/realms/scf
OIDC_CLIENT_ID=scf-platform
# Confidential client secret. Generate your own (openssl rand -hex 32); idp-init
# writes THIS value into Keycloak at boot, so the secret lives only here in env.
OIDC_CLIENT_SECRET=changeme-generate-a-real-oidc-secret
# Redirect URI registered for the client. The browser loads the frontend on 5173
# and Vite proxies /api -> backend, so the URI deployers actually use on the dev
# stack is the 5173 one below (it reaches the backend's /api/auth/callback through
# the proxy). http://localhost:8000/api/auth/callback (backend direct) is also a
# registered redirect for callers that hit the API port directly.
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/callback

# ---- EMAIL NOTIFICATIONS (Resend — optional) ------------------------------
# Leave RESEND_API_KEY blank to disable outbound email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@example.com
# Public URL of the frontend, used in links inside notification emails:
APP_URL=http://localhost:5173

# ---- EVIDENCE STORAGE -----------------------------------------------------
# By DEFAULT the stack uses the bundled MinIO container (S3-compatible) so you
# need no cloud account. The values below match the MinIO service in
# docker-compose.yml — change the password for anything beyond local eval.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme-minio-password
EVIDENCE_BUCKET=evidence
# S3 credentials the backend uses — must match the MINIO_ROOT_* values above:
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=changeme-minio-password
AWS_DEFAULT_REGION=eu-west-1
# Internal endpoint the backend/worker use; public endpoint the browser uses for
# presigned upload/download URLs. Leave as-is for the bundled MinIO.
#
# EVIDENCE_PUBLIC_ENDPOINT stays COMMENTED OUT for the default same-machine
# install: when unset, docker-compose.yml defaults it to
# http://localhost:<MINIO_PORT>, so it follows a remapped MINIO_PORT
# automatically. Setting it here overrides that auto-follow.
#
# REMOTE-HOST DEPLOYS: uncomment and set it to an address YOUR BROWSER can
# reach. If the stack runs on a different machine than the one you browse
# from, localhost won't resolve — use the host's IP or DNS name (e.g.
# http://my-docker-host:9000) or evidence upload/download will fail silently.
AWS_ENDPOINT_URL=http://minio:9000
# EVIDENCE_PUBLIC_ENDPOINT=http://localhost:9000
#
# To use AWS S3 instead of MinIO: set EVIDENCE_BUCKET to your real bucket, set
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY to real credentials, and set BOTH
# AWS_ENDPOINT_URL= and EVIDENCE_PUBLIC_ENDPOINT= explicitly EMPTY (uncomment
# EVIDENCE_PUBLIC_ENDPOINT above and leave it blank; empty = use AWS S3 directly).
#
# To use Azure Blob instead: set the two values below (takes priority over S3).
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
EVIDENCE_CONTAINER=evidence

# ---- AI ASSESSMENT (LLMs — optional) ---------------------------------
# Enables AI-assisted evidence/window assessment. Leave blank to disable.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- DOCUMENT GENERATION (optional) ---------------------------------------
# Generates ISMS documents (Statement of Applicability, domain policies,
# procedures) from scoped control data. None of these variables switch the
# feature on: that is a per-organisation setting in the admin panel, and it
# cannot be enabled until an administrator has acknowledged the SCF licence.
# The variables below only shape how generation behaves once it is on.
#
# AI-augmented generators (policies, procedures, standards) reuse
# ANTHROPIC_API_KEY from the AI ASSESSMENT block above — there is no separate
# key. With no key set, or with DOC_GEN_AI_MOCK=1, those generators return a
# clearly-marked sample instead of calling the API, so the feature is walkable
# end to end without spending anything. Tier 1 documents are template-rendered
# and never call an LLM, key or no key.
# DOC_GEN_AI_MOCK=1
#
# ---- Which model the platform calls -----------------------------------------
#
# ONE variable moves the whole platform. Models are retired on the provider's
# schedule, not ours, so this is deliberately a deploy-free change: set it,
# recreate the containers, done.
#
# SCF_AI_MODEL=claude-sonnet-4-6
#
# It applies to every compliance task that asks for "the platform's model":
# evidence assessment, artifact-type extraction, vendor assessment, system
# recipe generation and AI-augmented document generation.
#
# It does NOT apply to the three CDM intent-extraction roles. Those run the same
# job against three different providers on purpose, so no single id can be right
# for all of them — a Claude id sent to the Gemini endpoint just 404s. They keep
# their own variables, below.
#
# The ids the platform knows about, with their prices, are declared in
# backend/services/model_registry.py. An id that is not in that file is still
# called as given — production must be able to escape a bad default — but its
# cost is recorded as NULL rather than guessed, and the weekly liveness check
# cannot vouch for it.
#
# ---- Per-role overrides (escape hatches) ------------------------------------
#
# Each role also has its own variable, which BEATS SCF_AI_MODEL. Use one to hold
# a single service back or push it forward — "everything on the new model except
# doc-gen, which regressed" — not as the normal way to configure a model.
#
#   EVIDENCE_AI_MODEL         AI evidence assessment (per-file and per-window)
#   ARTIFACT_TYPE_AI_MODEL    artifact-type extraction (CLI/backfill)
#   VENDOR_AI_MODEL           vendor assessment
#   SYSTEMS_AI_MODEL          system recipe generation
#   DOC_GEN_AI_MODEL          AI-augmented document generation
#   CDM_INTENT_CLAUDE_MODEL   CDM intent extraction, Claude provider
#   CDM_INTENT_GPT_MODEL      CDM intent extraction, OpenAI provider
#   CDM_INTENT_GEMINI_MODEL   CDM intent extraction, Gemini provider
#
# Platform-wide kill switch. Set to 1 to refuse every generation request for
# every organisation regardless of their settings, without unpicking any
# per-org configuration or deleting documents already generated. This is the
# operator's lever for a licensing question that needs answering before more
# derivative work is produced — not a feature toggle.
# DOC_GEN_DISABLED=1

# ---- VENDOR RESEARCH (optional) -------------------------------------------
# Third-party breach / vulnerability lookups used by vendor research tasks.
HIBP_API_KEY=
NVD_API_KEY=

# ---- TELEMETRY (optional) -------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---- CATALOGUE IMPORTER (optional) ----------------------------------------
# Path to your SCF Excel workbook for `docker compose --profile init run
# catalog-importer`. Defaults to ./catalog-source/scf.xlsx if unset.
# SCF_XLSX=./catalog-source/scf.xlsx

# ---- ASSURANCE / KSI FEATURE FLAGS (optional) ------------------------------
# All three default off, which is the behaviour every existing deployment
# already has. Set them on BOTH the backend and celery-worker: the two
# services answer the same questions and a flag set on only one produces two
# different scores for the same organization.
#
# ENABLE_PER_WINDOW_REVIEW moves review from per-file to per-window. The
# webclient has its own build-time twin, VITE_ENABLE_PER_WINDOW_REVIEW; if
# the two disagree the app logs the mismatch at startup (GET /api/features
# reports what the backend believes). A backend with this on and a bundle
# built without it leaves reviewers with no working review path at all.
# ENABLE_PER_WINDOW_REVIEW=false
#
# The two KSI flags choose which assessment tier the evidence-quality axis
# reads: composite > window > per-file. Composite is independent of window —
# with composite on and window off, the fallback is per-file.
# ENABLE_WINDOW_ASSESSMENT_KSI=false
# ENABLE_COMPOSITE_KSI=false

# ---- CONTROL DOCUMENTS MAPPER / CDM (optional) ----------------------------
# Maps uploaded policy documents to scoped controls. Off by default; the
# per-tenant flag (Organization.settings.cdm_enabled) overrides this one.
# ENABLE_CDM=false

# Retrieval backend. The default runs entirely inside Postgres — no extra
# services — and is the only backend that can return the character offsets a
# mapping needs. `lightrag` additionally requires ENABLE_CDM_LIGHTRAG=true
# and can only serve exploratory search: the mapping path refuses it rather
# than writing citations it cannot prove.
# CDM_RETRIEVAL_BACKEND=postgres_fts
# ENABLE_CDM_LIGHTRAG=false

# Extraction backend. In-process handles PDF (PyMuPDF), DOCX, CSV, JSON,
# YAML and plain text with no sidecar. `docling` gives better table fidelity
# for SoA and register documents but needs a Docling service, which this
# compose file does not ship; selecting it without CDM_DOCLING_URL falls back
# to in-process rather than failing the ingest.
# CDM_EXTRACTION_BACKEND=inprocess
# CDM_DOCLING_URL=

# Mapping score = weighted sum of three observable components. Weights are
# normalised to sum to 1.0 and persisted on every mapping row, so any score
# can be recomputed later even after these values change.
#   ts_rank            — Postgres full-text relevance, normalised to [0,1)
#   objective_coverage — share of the control's assessment objectives matched
#   term_overlap       — share of distinct control terms present in the passage
# CDM_SCORE_WEIGHT_TS_RANK=0.5
# CDM_SCORE_WEIGHT_OBJECTIVE_COVERAGE=0.3
# CDM_SCORE_WEIGHT_TERM_OVERLAP=0.2

# Minimum score to propose a mapping, and candidates considered per control.
# Raise the threshold for a quieter queue, lower it for wider recall; every
# proposal is human-reviewed before it counts for anything.
# CDM_MAPPING_SCORE_THRESHOLD=0.15
# CDM_MAPPING_TOP_K=25

# Document placement (optional, off by default). Classifies each uploaded
# document into the domains it appears to cover, so the Document Map can show
# where a document sits before anyone has reviewed a mapping. Placement never
# creates, scores or cites a mapping — offsets remain the only mapping source.
#
# Leaving this disabled has one visible effect: a document that produces no
# mappings sits in the Document Map's "Unmapped" rail labelled "Awaiting
# classification" indefinitely, and the UI does not explain that the stage is
# off. Runs on its own Celery queue (cdm_intent) so a slow document cannot
# head-of-line block ordinary ingest.
# Provider values: disabled, claude, gpt, gemini.
# CDM_INTENT_PROVIDER=disabled
# CDM_INTENT_TIMEOUT_S=300
# CDM_INTENT_MAX_DOMAINS=3
# Within-domain precision filters (#712). Per-control, relative measures —
# they bound reviewer effort per control and degrade gracefully on low-signal
# documents, unlike a raised absolute threshold. The cap keeps the top N
# proposals per control by composed score; the cutoff drops hits scoring below
# the given fraction of that control's best hit. The best hit always survives.
# CDM_MAX_PROPOSALS_PER_CONTROL=3
# CDM_RELATIVE_SCORE_CUTOFF=0.6
