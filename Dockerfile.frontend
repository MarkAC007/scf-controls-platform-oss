# Dockerfile for CG CCF Frontend (React SPA)
# Multi-stage build: Node.js for building, nginx for serving

# Placeholder for the operator's secrets directory. docker-compose.secrets.yml
# replaces it with a named build context (`additional_contexts: scf_secrets:`);
# a plain build leaves it empty and the build step below falls back to the
# VITE_API_KEY build arg.
FROM scratch AS scf_secrets

# Stage 1: Build
# Node.js 20.20.2. The tag is kept so the line stays readable; the digest is what is
# pulled. Change the two together.
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS builder

WORKDIR /app

# Copy package files
COPY webclient/package*.json ./

# Install dependencies
RUN npm ci && npm cache clean --force

# Copy source code
COPY webclient/ ./

# Build arguments (only for Google Auth, not API URL)
ARG VITE_GOOGLE_AUTH_ENABLED
ARG VITE_OIDC_ENABLED
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_API_KEY
ARG VITE_DEBUG_API
# Build-time twin of the backend's ENABLE_PER_WINDOW_REVIEW; defaults on.
ARG VITE_ENABLE_PER_WINDOW_REVIEW=true

# Set as environment variables for Vite build
ENV VITE_GOOGLE_AUTH_ENABLED=$VITE_GOOGLE_AUTH_ENABLED
ENV VITE_OIDC_ENABLED=$VITE_OIDC_ENABLED
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_API_KEY=$VITE_API_KEY
ENV VITE_DEBUG_API=$VITE_DEBUG_API
ENV VITE_ENABLE_PER_WINDOW_REVIEW=$VITE_ENABLE_PER_WINDOW_REVIEW


# Build the bundle. When the platform is running on API-key auth (OIDC off),
# the key the bundle sends has to match the backend's API_KEY. Installs made
# by the first-run wizard (#947) keep that key in a 0600 secrets file and never
# in .env, so docker-compose.secrets.yml points the `scf_secrets` build context
# at that directory and this step bind-mounts the API_KEY file for the duration
# of `npm run build` only. Nothing is copied into a layer, so the value is not
# in `docker history` or `docker inspect`; and because a bind mount is content
# addressed, rotating the key invalidates the cached build step (a BuildKit
# `--mount=type=secret` would not: secrets are excluded from the cache key, so
# a rotated key would silently reuse the layer built with the old one).
# Without the overlay the `scf_secrets` stage below is empty and the legacy
# VITE_API_KEY build arg applies unchanged; the mounted file wins when both
# are present. Only the API-key sign-in path reads the file: with OIDC or
# Google auth enabled the browser holds a user token instead, and a
# deployment that deliberately built with a blank VITE_API_KEY must not start
# shipping the master key to every browser the day it adopts the overlay.
RUN --mount=type=bind,from=scf_secrets,target=/run/scf_secrets \
    if [ "$VITE_OIDC_ENABLED" != "true" ] && [ "$VITE_GOOGLE_AUTH_ENABLED" != "true" ] \
       && [ -s /run/scf_secrets/API_KEY ]; then \
      VITE_API_KEY="$(cat /run/scf_secrets/API_KEY)" npm run build; \
    else \
      npm run build; \
    fi

# Stage 2: Production with nginx
# nginx 1.31.9. The tag is kept so the line stays readable; the digest is what is
# pulled. Change the two together.
#
# The slim variant is the same nginx build without the optional modules (ACME,
# xslt, image filter, GeoIP, njs) and the libraries they need (libxml2,
# libxslt, libgd and others), and without curl and the CA certificate tools.
# nginx.conf loads none of those modules, and every package left out is one
# fewer for the scanner to find advisories in.
FROM nginx:alpine-slim@sha256:5bfced78d24d644270bedb0a9968697042e38d5c03fb6354603df025279c1cbe

# apk upgrade installs every fix Alpine has published for the packages in the
# base image, on the day this layer is built. The digest above pins nginx and
# the Alpine release, not these packages: a base image is rebuilt less often
# than Alpine ships fixes, and the release scan gate blocks a finding that has
# a fix. This is a deliberate exception to the seven-day cooldown on dependency
# updates. The packages come signed from the repositories of the base image's
# Alpine release (main and community), which carry security and bug fixes for
# that release, sometimes as a new upstream version (zlib 1.3.2 to 1.4, for
# one), and never a new Alpine release. Two builds of one commit can therefore
# differ; the SBOM published with each release records what the published image
# holds. A build that reuses a cached layer keeps that layer's packages: the
# release and CI builds use no cache.
#
# nginx itself must not move. It comes from nginx.org, and Alpine has an older
# package of the same name. The base image pins the nginx version in
# /etc/apk/world, which is what holds it; the last command stops the build if
# the upgrade changed the nginx build anyway.
#
# envsubst renders nginx.conf and is already in the slim image. jq builds
# /config.js: jq rather than shell escaping because a config value is arbitrary
# operator input being written into a JavaScript file — a newline breaks it and
# a `</script>` ends it early. See docker-entrypoint.sh.
RUN nginx_before="$(nginx -V 2>&1)" && \
    apk upgrade --no-cache && apk add --no-cache jq && \
    [ "$(nginx -V 2>&1)" = "$nginx_before" ]

# Copy built files from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration template
COPY nginx.conf /etc/nginx/nginx.conf.template

# Copy entrypoint script
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Backend URL will be injected at runtime via environment variable
# Nginx will use envsubst to substitute BACKEND_URL in nginx.conf
ENV BACKEND_URL=""

# Expose port
EXPOSE 80

# Use entrypoint script to substitute BACKEND_URL and start nginx
CMD ["/docker-entrypoint.sh"]
