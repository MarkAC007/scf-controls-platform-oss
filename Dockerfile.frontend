# Dockerfile for CG CCF Frontend (React SPA)
# Multi-stage build: Node.js for building, nginx for serving

# Placeholder for the operator's secrets directory. docker-compose.secrets.yml
# replaces it with a named build context (`additional_contexts: scf_secrets:`);
# a plain build leaves it empty and the build step below falls back to the
# VITE_API_KEY build arg.
FROM scratch AS scf_secrets

# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY webclient/package*.json ./

# Install dependencies
RUN npm ci && npm cache clean --force

# Copy source code
COPY webclient/ ./

# Build arguments (only for Google Auth, not API URL)
ARG VITE_GOOGLE_AUTH_ENABLED
ARG VITE_OIDC_ENABLED
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_API_KEY
ARG VITE_DEBUG_API
# Build-time twin of the backend's ENABLE_PER_WINDOW_REVIEW; defaults on.
ARG VITE_ENABLE_PER_WINDOW_REVIEW=true

# Set as environment variables for Vite build
ENV VITE_GOOGLE_AUTH_ENABLED=$VITE_GOOGLE_AUTH_ENABLED
ENV VITE_OIDC_ENABLED=$VITE_OIDC_ENABLED
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_API_KEY=$VITE_API_KEY
ENV VITE_DEBUG_API=$VITE_DEBUG_API
ENV VITE_ENABLE_PER_WINDOW_REVIEW=$VITE_ENABLE_PER_WINDOW_REVIEW


# Build the bundle. When the platform is running on API-key auth (OIDC off),
# the key the bundle sends has to match the backend's API_KEY. Installs made
# by the first-run wizard (#947) keep that key in a 0600 secrets file and never
# in .env, so docker-compose.secrets.yml points the `scf_secrets` build context
# at that directory and this step bind-mounts the API_KEY file for the duration
# of `npm run build` only. Nothing is copied into a layer, so the value is not
# in `docker history` or `docker inspect`; and because a bind mount is content
# addressed, rotating the key invalidates the cached build step (a BuildKit
# `--mount=type=secret` would not: secrets are excluded from the cache key, so
# a rotated key would silently reuse the layer built with the old one).
# Without the overlay the `scf_secrets` stage below is empty and the legacy
# VITE_API_KEY build arg applies unchanged; the mounted file wins when both
# are present. Only the API-key sign-in path reads the file: with OIDC or
# Google auth enabled the browser holds a user token instead, and a
# deployment that deliberately built with a blank VITE_API_KEY must not start
# shipping the master key to every browser the day it adopts the overlay.
RUN --mount=type=bind,from=scf_secrets,target=/run/scf_secrets \
    if [ "$VITE_OIDC_ENABLED" != "true" ] && [ "$VITE_GOOGLE_AUTH_ENABLED" != "true" ] \
       && [ -s /run/scf_secrets/API_KEY ]; then \
      VITE_API_KEY="$(cat /run/scf_secrets/API_KEY)" npm run build; \
    else \
      npm run build; \
    fi

# Stage 2: Production with nginx
FROM nginx:alpine

# envsubst (gettext) renders nginx.conf; jq builds /config.js.
# jq rather than shell escaping because a config value is arbitrary operator
# input being written into a JavaScript file — a newline breaks it and a
# `</script>` ends it early. See docker-entrypoint.sh.
RUN apk add --no-cache gettext jq

# Copy built files from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration template
COPY nginx.conf /etc/nginx/nginx.conf.template

# Copy entrypoint script
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Backend URL will be injected at runtime via environment variable
# Nginx will use envsubst to substitute BACKEND_URL in nginx.conf
ENV BACKEND_URL=""

# Expose port
EXPOSE 80

# Use entrypoint script to substitute BACKEND_URL and start nginx
CMD ["/docker-entrypoint.sh"]
