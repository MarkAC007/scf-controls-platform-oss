# Dockerfile for CG CCF Frontend (Development)
# Uses Vite dev server for local development with hot reload

# Node.js 20.20.2. The tag is kept so the line stays readable; the digest is what is
# pulled. Change the two together.
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293

WORKDIR /app

# Copy package files including lockfile for reproducible installs
COPY webclient/package*.json ./

# Install exactly what webclient/package-lock.json pins. `npm ci` stops if the
# lockfile and package.json disagree and never changes either. The lockfile
# lists the Rollup binary for every platform, so there is nothing to add here.
RUN npm ci && npm cache clean --force

# Copy source code
COPY webclient/ ./

# Build arguments (only for Google Auth, not API URL)
ARG VITE_GOOGLE_AUTH_ENABLED
ARG VITE_OIDC_ENABLED
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_API_KEY
ARG VITE_DEBUG_API

# Set as environment variables for Vite
ENV VITE_GOOGLE_AUTH_ENABLED=$VITE_GOOGLE_AUTH_ENABLED
ENV VITE_OIDC_ENABLED=$VITE_OIDC_ENABLED
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_API_KEY=$VITE_API_KEY
ENV VITE_DEBUG_API=$VITE_DEBUG_API

# Expose Vite dev server port
EXPOSE 5173

# Start Vite dev server (with proxy configured in vite.config.ts)
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
