# setuptools is in the base image, and pyclamd is built against it
# (--no-build-isolation in Dockerfile.backend). Pinned here so the image does
# not keep the base image's copy: setuptools 79.0.1 vendors wheel 0.45.1 and
# jaraco.context 5.3.0, both with High advisories (GHSA-8rrh-rw8j-w5fx,
# GHSA-58pv-8j8x-9vj2). 84.2.1 vendors wheel 0.46.3 and jaraco.context 6.1.0.
setuptools>=84.2.1

# One version per package (backend/tests/test_python_lock.py).
# The images run Python 3.11. Each package below has dropped Python 3.11 in its
# newest releases. Left open, the lock pins such a package twice, an older
# version for 3.11 and a newer one for 3.12 and up, and Dependabot cannot
# update a lock that pins a package twice. Each cap holds the package at the
# last release line that still supports 3.11. Nothing here is imported by the
# project directly: numpy comes with pandas, networkx with pymupdf,
# deprecated with limits. Raise a cap when the images move to a newer Python,
# and keep the matching ignore rule in .github/dependabot.yml (where this tree
# has that file) in step.
numpy<2.5        # 2.5 needs Python 3.12
networkx<3.7     # 3.7 needs Python 3.12
deprecated<3     # 3.0 needs Python 3.12
